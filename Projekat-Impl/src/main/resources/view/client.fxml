<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ClientController">

    <top>

        <VBox spacing="10"
              style="-fx-padding: 10;">

            <HBox spacing="10">

                <Button text="Pocetna"
                        onAction="#pocetna"/>

                <Button text="Moji recepti"
                        onAction="#mojiRecepti"/>

                <Button text="Kreiraj recept"
                        onAction="#kreirajRecept"/>

                <Button text="Sacuvani recepti"
                        onAction="#sacuvaniRecepti"/>

                <Button text="Nutritivni podaci"
                        onAction="#nutritivni"/>

                <Button text="Moj profil"
                        onAction="#mojProfil"/>

                <Label text="Upravljanje receptom"/>

                <TextField fx:id="receptIDField"
                           promptText="ID recepta"/>

                <Button text="Ukloni recept"
                        onAction="#ukloniRecept"/>

                <Button text="Aktiviraj recept"
                        onAction="#aktivirajRecept"/>

            </HBox>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Pretraga recepata"/>

                <Button text="Pretrazi"
                        onAction="#pretragaRecepata"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <TableView fx:id="recipeTable">

            <columns>

                <TableColumn fx:id="idCol"
                             text="ID"
                             prefWidth="100"/>

                <TableColumn fx:id="nazivCol"
                             text="Naziv"
                             prefWidth="250"/>

                <TableColumn fx:id="opisCol"
                             text="Opis"
                             prefWidth="400"/>

                <TableColumn fx:id="sastojciCol"
                             text="Sastojci"
                             prefWidth="350"/>

                <TableColumn fx:id="ocjenaCol"
                             text="Ocjena"
                             prefWidth="100"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="120"/>
            </columns>

        </TableView>

    </center>

</BorderPane>